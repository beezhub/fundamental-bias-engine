# Copy to .env and fill in. Never commit .env.

# Free key from https://fredaccount.stlouisfed.org/apikeys
# Backs the monetary, inflation, growth and employment pillars.
FRED_API_KEY=

# Optional overrides for the risk module. Defaults come from the trading plan.
FBE_ACCOUNT_CURRENCY=ZAR
FBE_ACCOUNT_BALANCE=2000

# Set to 1 to run from cache only, never touching the network.
FBE_OFFLINE=0
