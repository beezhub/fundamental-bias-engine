{#- Single-file HTML dashboard.

    Context comes from fbe.report.build_context (report, diff, config,
    currencies, pairs, grid, pillar_order) plus a `view` namespace supplied by
    fbe.dashboard.build.render_dashboard for anything that needs arithmetic:

      view.title            page title string
      view.bar_pct(value)   bar half-width as a percentage of the widest score
      view.heat(spread)     css class for a heatmap cell, heat-p1..p4 / n1..n4
      view.at_pct(when)     position of a timestamp on the 24h calendar strip
      view.span_pct(a, b)   width of a blackout window on that strip
      view.legend           ordered (class, label) pairs for the heatmap legend

    Arithmetic lives in Python because arithmetic in a template cannot be
    tested. Constraints this file must keep are listed in the module docstring
    of fbe/dashboard/build.py; check_constraints enforces them on the output.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ view.title }}</title>
<style>
/* Light palette on bare :root. Every token gets its first definition here, so
   no colour exists only inside a media query. The heat ramp is a diverging
   pair, blue for a positive spread and red for a negative one, with a neutral
   grey at zero: near zero must read as "no view", not as a weak signal.
   Re-run the palette validator against both surfaces when these steps change. */
:root {
  color-scheme: light;
  --surface:        #fcfcfb;
  --plane:          #f9f9f7;
  --raised:         #ffffff;
  --text-primary:   #0b0b0b;
  --text-secondary: #52514e;
  --text-muted:     #898781;
  --hairline:       #e1e0d9;
  --axis:           #c3c2b7;
  --accent:         #2a78d6;
  --pos-1: #cde2fb; --pos-2: #9ec5f4; --pos-3: #5598e7; --pos-4: #2a78d6;
  --neg-1: #fbdcdc; --neg-2: #f4b0b0; --neg-3: #e87a7a; --neg-4: #d03b3b;
  --zero:  #f0efec;
  --heat-ink-lo:  #0b0b0b;
  --heat-ink-hi:  #ffffff;
  --good:     #0ca30c;
  --warning:  #fab219;
  --critical: #d03b3b;
  --gutter: 16px;
}
/* Dark values under the OS setting, guarded so an explicit light stamp wins. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface:        #1a1a19;
    --plane:          #0d0d0d;
    --raised:         #222221;
    --text-primary:   #ffffff;
    --text-secondary: #c3c2b7;
    --text-muted:     #898781;
    --hairline:       #2c2c2a;
    --axis:           #383835;
    --accent:         #3987e5;
    --pos-1: #184f95; --pos-2: #256abf; --pos-3: #2a78d6; --pos-4: #5598e7;
    --neg-1: #5c1c1c; --neg-2: #8c2b2b; --neg-3: #d03b3b; --neg-4: #e66767;
    --zero:  #383835;
    --heat-ink-lo: #e8e8e4;
    --heat-ink-hi: #0b0b0b;
  }
}
/* The same dark values under an explicit toggle, so it wins in both
   directions and not only when the OS is already dark. */
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface:        #1a1a19;
  --plane:          #0d0d0d;
  --raised:         #222221;
  --text-primary:   #ffffff;
  --text-secondary: #c3c2b7;
  --text-muted:     #898781;
  --hairline:       #2c2c2a;
  --axis:           #383835;
  --accent:         #3987e5;
  --pos-1: #184f95; --pos-2: #256abf; --pos-3: #2a78d6; --pos-4: #5598e7;
  --neg-1: #5c1c1c; --neg-2: #8c2b2b; --neg-3: #d03b3b; --neg-4: #e66767;
  --zero:  #383835;
  --heat-ink-lo: #e8e8e4;
  --heat-ink-hi: #0b0b0b;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--plane);
  color: var(--text-primary);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
}
/* One wrapper owns the side gutter. Vertical padding is set on its own axis so
   the shorthand can never zero the gutter out. */
.wrap {
  max-width: 960px;
  margin: 0 auto;
  padding-inline: var(--gutter);
  padding-block: 20px 48px;
}
h1 { font-size: 20px; margin: 0 0 4px; }
h2 { font-size: 15px; margin: 32px 0 8px; letter-spacing: .04em;
     text-transform: uppercase; color: var(--text-secondary); }
h3 { font-size: 15px; margin: 0 0 4px; }
p { margin: 0 0 8px; }
.meta { color: var(--text-muted); font-size: 13px; }
.card {
  background: var(--surface);
  border: 1px solid var(--hairline);
  border-radius: 10px;
  padding: 12px 14px;
}
.num { font-variant-numeric: tabular-nums; }

/* Currency ranking: bars grow left and right from a centre zero line, because
   the sign is the message. Rows are a grid so the labels align regardless of
   bar width. */
.rank-row {
  display: grid;
  grid-template-columns: 44px 1fr 60px;
  align-items: center;
  gap: 8px;
  padding: 3px 0;
}
.rank-track { position: relative; height: 18px; }
.rank-track::before {
  content: ""; position: absolute; left: 50%; top: 0; bottom: 0;
  border-left: 1px solid var(--axis);
}
.rank-bar {
  position: absolute; top: 3px; height: 12px;
  border-radius: 4px;
}
.rank-bar.pos { left: 50%; background: var(--pos-4); }
.rank-bar.neg { right: 50%; background: var(--neg-4); }
.rank-value { text-align: right; color: var(--text-secondary); font-size: 13px; }
.thin { opacity: .55; }

/* The matrix is wider than a phone, so it scrolls inside its own container and
   the page itself never scrolls sideways. */
.scroll-x { overflow-x: auto; -webkit-overflow-scrolling: touch; }
table.matrix { border-collapse: separate; border-spacing: 2px; font-size: 12px; }
table.matrix th { color: var(--text-muted); font-weight: 500; padding: 2px 4px; }
table.matrix td {
  width: 42px; height: 30px; text-align: center; border-radius: 4px;
  background: var(--zero); color: var(--text-secondary);
}
.heat-p1 { background: var(--pos-1); color: var(--heat-ink-lo); }
.heat-p2 { background: var(--pos-2); color: var(--heat-ink-lo); }
.heat-p3 { background: var(--pos-3); color: var(--heat-ink-hi); }
.heat-p4 { background: var(--pos-4); color: var(--heat-ink-hi); }
.heat-n1 { background: var(--neg-1); color: var(--heat-ink-lo); }
.heat-n2 { background: var(--neg-2); color: var(--heat-ink-lo); }
.heat-n3 { background: var(--neg-3); color: var(--heat-ink-hi); }
.heat-n4 { background: var(--neg-4); color: var(--heat-ink-hi); }
.diag { background: transparent; }
.legend { display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
          font-size: 12px; color: var(--text-secondary); margin-top: 8px; }
.swatch { width: 22px; height: 12px; border-radius: 3px; display: inline-block; }

/* The two marks the matrix carries. A dashed cell holds a marker of its own;
   a faded one has a leg below full coverage, which is the same fading the
   ranking uses for a thin row. Both are stated again in the pair detail, where
   there is room to say which marker and whose coverage. Marked, not blocked:
   three of the blocker kinds record a check rather than a refusal. */
table.matrix td.marked { outline: 2px dashed var(--axis); outline-offset: -3px; }
td.diag { color: var(--text-muted); text-align: center; }
details.pair { border-top: 1px solid var(--hairline); padding: 6px 0; }
details.pair summary { cursor: pointer; display: flex; flex-wrap: wrap;
                       gap: 8px; align-items: baseline; }
.pair-name { font-weight: 600; }
table.pillars { border-collapse: collapse; width: 100%; font-size: 12px;
                margin-top: 6px; }
table.pillars th, table.pillars td { padding: 3px 6px; text-align: right; }
table.pillars thead th:first-child,
table.pillars th[scope="row"] { text-align: left; color: var(--text-secondary); }
tr.obs td { text-align: left; color: var(--text-muted); }
tr.obs ul { margin: 0 0 4px; padding-left: 18px; }
/* A run condition wraps between conditions, never inside one: "event:unchecked,
   28 of" on one line and "28" on the next is a count a reader has to reassemble. */
.condition { white-space: nowrap; }

.cards { display: grid; gap: 10px; }
@media (min-width: 720px) { .cards { grid-template-columns: 1fr 1fr; } }
.tag {
  display: inline-block; font-size: 11px; letter-spacing: .04em;
  text-transform: uppercase; padding: 1px 6px; border-radius: 999px;
  border: 1px solid var(--hairline); color: var(--text-secondary);
}
.tag.long  { border-color: var(--pos-4); color: var(--pos-4); }
.tag.short { border-color: var(--neg-4); color: var(--neg-4); }
.tag.block { border-color: var(--critical); color: var(--critical); }

/* Calendar strip: one 24h axis with blackout windows shaded and events
   ticked, so "is the window clear" is answered by looking. */
.strip { position: relative; height: 46px; border-radius: 8px;
         background: var(--surface); border: 1px solid var(--hairline); }
.strip .window { position: absolute; top: 0; bottom: 0;
                 background: var(--neg-1); opacity: .8; }
.strip .tick { position: absolute; top: 0; bottom: 18px; width: 2px;
               background: var(--critical); }
.strip .hour { position: absolute; bottom: 2px; font-size: 10px;
               color: var(--text-muted); transform: translateX(-50%); }
.strip .now { position: absolute; top: 0; bottom: 0; width: 2px;
              background: var(--accent); }

table.plain { width: 100%; border-collapse: collapse; font-size: 13px; }
table.plain th { text-align: left; color: var(--text-muted); font-weight: 500;
                 border-bottom: 1px solid var(--hairline); padding: 5px 6px; }
table.plain td { border-bottom: 1px solid var(--hairline); padding: 5px 6px; }
ul.notes { margin: 0; padding-left: 18px; color: var(--text-secondary); }
.toggle { background: none; border: 1px solid var(--hairline); color: inherit;
          border-radius: 999px; padding: 4px 10px; font: inherit;
          font-size: 12px; cursor: pointer; }
.head { display: flex; flex-wrap: wrap; gap: 8px;
        align-items: baseline; justify-content: space-between; }
</style>
</head>
<body>
<div class="wrap">

  <header class="head">
    <div>
      <h1>G10 fundamental bias, {{ report.asof.strftime('%d %b %Y') }}</h1>
      <p class="meta">
        Generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M %Z') }}
        &middot; config <span class="num">{{ report.config_digest }}</span>
        &middot; {{ report.shortlist | length }} shortlisted
      </p>
    </div>
    <button class="toggle" type="button" data-theme-toggle>Theme</button>
  </header>

  <p class="meta">
    Directional bias only. Entries stay with the trendline and channel rules on
    the 1h and 4h charts.
  </p>

  {#- A blocker carried by every pair is one fact about the run, not 28 facts
      about pairs, so it is printed here and not repeated in the matrix. Every
      kind present carries its count against the total, because the same key on
      3 of 28 and on 28 of 28 read differently. docs/interfaces.md, "A blocker
      true for every pair is a run condition". -#}
  {% if view.blocker_counts %}
  <p class="meta run-conditions">
    Run conditions:
    {% for row in view.blocker_counts %}
    <span class="condition">{{ row.kind }}, {{ row.count }} of {{ row.total }}</span>{% if not loop.last %} &middot;{% endif %}
    {%- endfor %}
    <br>Any condition carried by every pair is named here only, and not
    repeated on the cells below.
  </p>
  {% endif %}

  <h2>Currency ranking</h2>
  <div class="card">
    {% for score in currencies %}
    <div class="rank-row{{ ' thin' if score.coverage < 1 }}">
      {#- A currency the run scored on nothing gets no bar and no rank. Drawn
          at zero the bar is indistinguishable from a currency the model
          scored at the middle of its band, and a rank places it among the
          currencies that were measured. Both are the opposite fact. -#}
      <div><strong>{{ score.currency }}</strong>
        {% if score.coverage > 0 %}<span class="meta num">{{ score.rank }}</span>{% endif %}</div>
      {% if score.coverage <= 0 %}
      <div class="rank-track"><span class="meta">not scored, no pillar data</span></div>
      <div class="rank-value meta">n/a</div>
      {% else %}
      <div class="rank-track">
        <div class="rank-bar {{ 'pos' if score.composite >= 0 else 'neg' }}"
             style="width: {{ view.bar_pct(score.composite) }}%"></div>
      </div>
      <div class="rank-value num">
        {{ '%+.2f' | format(score.composite) }}
        {%- if score.coverage < 1 %}
        <span class="meta">{{ view.pct(score.coverage) }}</span>
        {%- endif %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    <p class="meta">
      Composite on the -3 to +3 band, bars drawn against the widest score in
      the run. A faded row carries the share of pillar weight that had data
      beside its score; a row with no bar had none.
    </p>
  </div>

  <h2>Pair matrix</h2>
  <div class="card">
    <div class="scroll-x">
      <table class="matrix">
        <thead>
          <tr><th></th>
            {% for quote in grid %}<th scope="col">{{ quote }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for base, row in grid.items() %}
          <tr>
            <th scope="row">{{ base }}</th>
            {% for quote, cell in row.items() %}
              {% if cell is none %}
              {#- The documented placeholder rather than an empty cell or a
                  zero: a currency has no bias against itself, 0.00 there would
                  read as two economies level, and a blank reads as a cell the
                  run failed to fill. -#}
              <td class="diag" title="{{ base }} against itself">.</td>
              {% else %}
              {#- Cells come from fbe.report._grid already oriented for their
                  row, mirrored halves included: spread negated, legs swapped,
                  direction inverted. Colour and label them as they stand.
                  view.flags adds the marks: marked when the pair carries a
                  marker that is not true of every pair, thin when a leg scored
                  below full coverage. -#}
              <td class="num {{ view.heat(cell.spread) }}{{ view.flags(cell) }}"
                  title="{{ cell.base }} vs {{ cell.quote }}: {{ cell.direction.value }} {{ cell.base }}, {{ cell.conviction.value }} conviction">
                {{ '%+.1f' | format(cell.spread) }}
              </td>
              {% endif %}
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="legend">
      <span>quote stronger</span>
      {% for cls, label in view.legend %}
      <span class="swatch {{ cls }}" title="{{ label }}"></span>
      {% endfor %}
      <span>base stronger</span>
    </div>
    <p class="meta">
      Read along the row: the cell is the row currency's composite minus the
      column currency's. Every cell prints its own number, so nothing here is
      carried by colour alone. A faded cell has a leg below full coverage and a
      dashed cell carries a marker of its own; both are named in the pair
      detail below.
    </p>
  </div>

  <h2>Pair detail</h2>
  <div class="card">
    <p class="meta">
      Every pair in the run, widest spread first, each opening to the seven
      pillar scores behind it and the series those were read from. The pairs
      are in market convention here, so a mirrored cell in the matrix and its
      panel below are the same two legs written the two ways round. The spread
      is the matrix's own number to two decimals rather than one.
    </p>
    {% for bias in pairs %}
    {%- set detail = view.expansion(bias) %}
    <details class="pair">
      <summary>
        <span class="pair-name">{{ bias.pair }}</span>
        <span class="num">{{ '%+.2f' | format(bias.spread) }}</span>
        <span class="meta">{{ bias.direction.value }} {{ bias.base }} &middot;
          {{ bias.conviction.value }} conviction</span>
        {%- if detail.blockers %}
        <span class="tag">marked</span>
        {%- endif %}
      </summary>
      <p class="meta">
        Coverage:
        {% if detail.base_coverage is none %}{{ bias.base }} not scored{% else %}{{ bias.base }} {{ view.pct(detail.base_coverage) }}{% endif %}
        &middot;
        {% if detail.quote_coverage is none %}{{ bias.quote }} not scored{% else %}{{ bias.quote }} {{ view.pct(detail.quote_coverage) }}{% endif %}
      </p>
      {%- if detail.blockers %}
      <p class="meta">On this pair: {{ detail.blockers | join(', ') }}</p>
      {%- endif %}
      <table class="pillars">
        <thead>
          <tr>
            <th scope="col">Pillar</th>
            <th scope="col">{{ bias.base }}</th>
            <th scope="col">{{ bias.quote }}</th>
            <th scope="col">Difference</th>
          </tr>
        </thead>
        <tbody>
          {% for line in detail.rows %}
          {#- A dot, never 0.00: a pillar the run could not score on a leg and a
              pillar that scored the economy mid-band are opposite facts. -#}
          <tr>
            <th scope="row">{{ line.pillar.value }}</th>
            <td class="num">{% if line.base is none %}.{% else %}{{ '%+.2f' | format(line.base.score) }}{% endif %}</td>
            <td class="num">{% if line.quote is none %}.{% else %}{{ '%+.2f' | format(line.quote.score) }}{% endif %}</td>
            <td class="num">{% if line.difference is none %}.{% else %}{{ '%+.2f' | format(line.difference) }}{% endif %}</td>
          </tr>
          {%- if line.inputs %}
          <tr class="obs">
            <td colspan="4">
              <ul>
                {% for item in line.inputs %}
                <li>{{ item.indicator }} ({{ item.currency }})
                  <span class="num">{{ '%g' | format(item.value) }}</span>
                  {{ item.unit }}, period {{ item.period }},
                  {% if item.released_at is none %}release date not recorded{% else %}released {{ item.released_at.strftime('%Y-%m-%d') }}{% endif %},
                  {{ item.source }} <span class="num">{{ item.series_id }}</span></li>
                {% endfor %}
              </ul>
            </td>
          </tr>
          {%- endif %}
          {% endfor %}
        </tbody>
      </table>
      <p class="meta">
        A dot is a pillar the run could not score on that leg, which is not a
        score of zero. The difference is the base leg's score minus the quote
        leg's, so a positive row prefers {{ bias.base }}.
      </p>
    </details>
    {% endfor %}
  </div>

  <h2>Shortlist</h2>
  {% if not report.shortlist %}
  <div class="card">
    <p>Nothing cleared the conviction and blocker filters today.</p>
    <p class="meta">
      A day with no fundamental disagreement wide enough to trade is a day to
      leave the platform closed. That is the plan working, not the engine
      failing.
    </p>
  </div>
  {% else %}
  <div class="cards">
    {% for idea in report.shortlist %}
    <article class="card">
      <h3>
        {{ idea.bias.pair }}
        <span class="tag {{ idea.bias.direction.value }}">
          {{ idea.bias.direction.value }}</span>
        <span class="tag">{{ idea.bias.conviction.value }}</span>
        {% if idea.blackout_until %}<span class="tag block">blackout</span>{% endif %}
      </h3>
      <p class="meta num">
        spread {{ '%+.2f' | format(idea.bias.spread) }}
        &middot; {{ idea.bias.base }} {{ '%+.2f' | format(idea.bias.base_score) }}
        vs {{ idea.bias.quote }} {{ '%+.2f' | format(idea.bias.quote_score) }}
        &middot; {{ view.pct(idea.bias.agreement) }} of pillar weight agrees
      </p>
      <p>{{ idea.rationale }}</p>
      {% if idea.size %}
      {#- realised_risk_amount is what the rounded lot size actually exposes,
          so it leads. The intended figure follows for the comparison. -#}
      <p class="meta num">
        {{ '%.2f' | format(idea.size.lots) }} lots on a
        {{ '%.1f' | format(idea.size.stop_distance_pips) }} pip stop,
        risking {{ idea.size.account_currency }}
        {{ '%.2f' | format(idea.size.realised_risk_amount) }}
        ({{ view.pct(idea.size.realised_risk_fraction, 2) }}
        of balance) against an intended
        {{ view.pct(idea.size.risk_fraction, 1) }} or
        {{ idea.size.account_currency }}
        {{ '%.2f' | format(idea.size.risk_amount) }}
      </p>
      {#- Size warnings on the card, not only in the dataclass. The Markdown
          report prints these under each ticket; leaving them off here is the
          #17-class defect on this surface, where the broker:unconfirmed marker
          and spread:unchecked would reach the dataclass and stop before the
          reader. -#}
      {% if idea.size.warnings %}
      <p class="meta">
        {% for warning in idea.size.warnings %}{{ warning }}{% if not loop.last %}<br>{% endif %}{% endfor %}
      </p>
      {% endif %}
      {% endif %}
      {% if idea.blackout_until %}
      <p class="meta">
        Stand aside until
        {{ idea.blackout_until.strftime('%H:%M %Z on %d %b') }}.
      </p>
      {% endif %}
      {#- A shortlisted idea is tradeable, so anything in blockers here is a
          check that did not run, or one that ran and could not finish, rather
          than a reason to stand aside. Labelling the list off
          idea.bias.tradeable rather than assuming it keeps the heading honest
          if the shortlist rule ever changes. Unlabelled, the two cases read
          identically, which is issue #17 on this surface.

          One label over both, with the reason in the list beneath it, is
          deliberate here and tested as such. The Markdown report now labels
          them apart, and whether this surface should follow is part of issue
          #45's first criterion, which waits on fbe.dashboard.build. -#}
      {% if idea.bias.blockers %}
      <p class="meta">
        {{ 'Not checked on this run' if idea.bias.tradeable else 'Blocked' }}:
      </p>
      <ul class="notes">
        {% for blocker in idea.bias.blockers %}<li>{{ blocker }}</li>{% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Next 24 hours</h2>
  <div class="card">
    <div class="strip">
      {% for window in view.blackouts %}
      <div class="window"
           style="left: {{ view.at_pct(window.start) }}%; width: {{ view.span_pct(window.start, window.end) }}%"
           title="{{ window.label }}"></div>
      {% endfor %}
      {% for event in report.events %}
      <div class="tick" style="left: {{ view.at_pct(event.scheduled_for) }}%"
           title="{{ event.currency }} {{ event.title }} ({{ event.impact }})"></div>
      {% endfor %}
      <div class="now" style="left: {{ view.at_pct(report.generated_at) }}%"
           title="now"></div>
      {% for hour, label in view.hour_marks %}
      <span class="hour" style="left: {{ view.at_pct(hour) }}%">{{ label }}</span>
      {% endfor %}
    </div>
    <table class="plain">
      <thead>
        <tr><th>When</th><th>CCY</th><th>Event</th><th>Impact</th></tr>
      </thead>
      <tbody>
        {% for event in report.events %}
        <tr>
          <td class="num">{{ event.scheduled_for.strftime('%a %H:%M') }}</td>
          <td>{{ event.currency }}</td>
          <td>{{ event.title }}</td>
          <td>{{ event.impact }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="meta">No qualifying events in the horizon.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Coverage and warnings</h2>
  <div class="card">
    {% if report.warnings %}
    <ul class="notes">
      {% for warning in report.warnings %}<li>{{ warning }}</li>{% endfor %}
    </ul>
    {% else %}
    <p class="meta">No warnings. Every pillar had data inside its staleness limit.</p>
    {% endif %}
  </div>

  <h2>Since the last run</h2>
  <div class="card">
    {% if not diff %}
    <p class="meta">No baseline run to compare against.</p>
    {% elif diff.config_changed %}
    <p>
      The config changed since {{ diff.previous_asof.strftime('%d %b') }}.
      Score movements are not comparable: re-weighting moves every currency at
      once.
    </p>
    {% else %}
    <table class="plain">
      <thead><tr><th>CCY</th><th>Then</th><th>Now</th><th>Delta</th></tr></thead>
      <tbody>
        {% for change in diff.currencies %}
        <tr>
          <td>{{ change.currency }}</td>
          <td class="num">{{ '%+.2f' | format(change.previous_composite) }}</td>
          <td class="num">{{ '%+.2f' | format(change.current_composite) }}</td>
          <td class="num">{{ '%+.2f' | format(change.delta) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if diff.pairs %}
    <ul class="notes">
      {% for change in diff.pairs %}
      <li>
        {{ change.pair }}:
        {{ change.previous_direction.value }} to {{ change.current_direction.value }},
        {{ change.previous_conviction.value }} to {{ change.current_conviction.value }}
        {%- if change.flipped %} (flip){% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if diff.shortlist_added %}
    <p class="meta">Entered: {{ diff.shortlist_added | join(', ') }}</p>
    {% endif %}
    {% if diff.shortlist_removed %}
    <p class="meta">
      Left:
      {% for pair, reason in diff.shortlist_removed %}
      {{ pair }} ({{ reason }}){{ ", " if not loop.last }}
      {%- endfor %}
    </p>
    {% endif %}
    {% endif %}
  </div>

  <p class="meta" style="margin-top:24px">
    Config digest <span class="num">{{ report.config_digest }}</span>.
    Rebuild with
    <span class="num">fbe dashboard --asof {{ report.asof.strftime('%Y-%m-%d') }}</span>.
  </p>
</div>

<script>
/* Inline only. No network calls of any kind and no external script: the
   sandbox blocks them without a visible error, and check_constraints reads the
   name of a blocked call inside this comment as a call, which is the safer
   direction for a check whose false negatives are invisible. The toggle stamps
   data-theme on the root, which the palette blocks above read in both
   directions. */
(function () {
  var root = document.documentElement;
  var button = document.querySelector("[data-theme-toggle]");
  if (!button) { return; }
  button.addEventListener("click", function () {
    var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    var current = root.getAttribute("data-theme") || (dark ? "dark" : "light");
    root.setAttribute("data-theme", current === "dark" ? "light" : "dark");
  });
})();
</script>
</body>
</html>
